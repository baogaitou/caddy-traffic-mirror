{
    debug
    admin off

    log mirror_log {
        output file ./mirror.log
        format console
    }
}

# Origin
:8090 {
    log {
        output stdout
        format transform "{ts} [ORIGIN] {status} => {request>method} {request>uri} {duration}s" {
            time_format "01-02 15:04:05"
        }
    }

    route {
        handle /demo {
            respond "Demo" 200
        }

        handle /api/* {
            # traffic_mirror 是 non-ordered handler，必须放在 route 块内
            route {
                traffic_mirror {
                    target_url http://localhost:9090
                    methods GET POST
                    add_mirror_headers true
                    timeout 3
                }
                respond "API from Origin" 200
            }
        }

        handle  {
            respond /* "Other path from Origin" 200
        }
    }
}

# Mirror - 9090
:9090 {
    log mirror_log

    respond "Received by Mirror Server (9090): {http.request.uri}" 200
}